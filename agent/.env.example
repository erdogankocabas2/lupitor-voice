# LiveKit Cloud (Settings > API keys). STT/LLM/TTS run through LiveKit Inference with these same keys.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Outbound SIP trunk created in LiveKit (Telephony > SIP trunks), e.g. ST_xxxxxxxx
SIP_OUTBOUND_TRUNK_ID=
# Optional: warm transfer target for hardship / human requests (E.164). If empty the agent ends the call after the handoff message.
HUMAN_TRANSFER_NUMBER=

# Supabase (Project settings > API). Service role key stays server-side only.
SUPABASE_URL=https://your-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Red-team harness only (text mode talks to OpenAI directly)
OPENAI_API_KEY=
REDTEAM_ATTACKER_MODEL=gpt-4.1

# Optional call recording via LiveKit Egress to Supabase Storage (S3 protocol)
RECORDING_S3_BUCKET=
RECORDING_S3_REGION=
RECORDING_S3_ENDPOINT=https://your-ref.supabase.co/storage/v1/s3
RECORDING_S3_ACCESS_KEY=
RECORDING_S3_SECRET=

AGENT_NAME=lupitor-agent
