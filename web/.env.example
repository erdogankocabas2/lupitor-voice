# Same LiveKit project as the agent
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
AGENT_NAME=lupitor-agent

# Supabase (server-side only; never exposed to the browser)
SUPABASE_URL=https://your-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Private storage bucket that call recordings are written to (optional)
RECORDINGS_BUCKET=

# Optional: protects the whole console with a password (any username)
CONSOLE_PASSWORD=
